(library
 (public_name greysynth.utils)
 (name greysynth_utils)
 (modules utils)
 (flags
  (:standard -open Binsec -open Smt -open Libsse -open Libterm -w "-58"))
 (libraries xyntia binsec.smt binsec.sse binsec.sse.term))

